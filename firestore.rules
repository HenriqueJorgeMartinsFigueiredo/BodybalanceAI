rules_version = '2';

// Fase 0: tudo negado.
// As regras reais (docs/03-ARQUITETURA.md, seção 5) e os testes de regras
// no emulador entram na Fase 8. Até lá, nenhum acesso pelo app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
